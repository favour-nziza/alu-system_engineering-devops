#!/usr/bin/env bash
# Installs nginx and makes /redirect_me return a 301 Moved Permanently redirection
apt-get -y update
apt-get -y install nginx
echo "Holberton School for the win!" > /var/www/html/index.html
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
	sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-available/default
fi
service nginx restart
